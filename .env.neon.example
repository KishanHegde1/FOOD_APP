# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# Neon PostgreSQL
# Copy the pooled or direct connection string from Neon Dashboard.
# Keep sslmode=require at the end.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOSTNAME.neon.tech/DATABASE?sslmode=require
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Firebase Admin SDK
# Option 1 for local development: use a project-relative path.
# Do not commit the service-account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2 for hosted environments: paste the full service-account JSON as one line.
# Leave commented unless you use it.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}

# Option 3 for hosted environments: base64 encode the service-account JSON.
# Leave commented unless you use it.
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Razorpay Test Mode - server only
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Optional legacy/local database variables.
# Leave these commented when DATABASE_URL is set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=food_app
